<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Amberflow</AssemblyName>
    <RootNamespace>Amberflow.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Amberflow.Application\Amberflow.Application.csproj" />
    <ProjectReference Include="..\Amberflow.Core\Amberflow.Core.csproj" />
  </ItemGroup>
</Project>
